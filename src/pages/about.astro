---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import { person, about, faq } from '../data/site.js';

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<Base
  title="About Angela Salud Chua"
  description="Angela Salud Chua has designed apps since 2008, starting in Manila. Founder of Toffeenut Design Studio and Head of Product Design at DigiValet."
  path="/about/"
  extraLd={faqLd}
>
  <main class="v-about">
    <Header home={false} />
    <div class="wrap a-main">
      <div class="a-top">
        <p class="lab">About</p>
        <h1 class="a-name">{person.name}</h1>
        <p class="a-line">{about.line}</p>
      </div>
      <section class="a-row" aria-label="Story">
        <h2>The short version</h2>
        <div class="a-story">{about.story.map((p) => <p>{p}</p>)}</div>
      </section>
      <section class="a-row ruled" aria-label="Brands">
        <h2>Brands she has designed for</h2>
        <p class="a-brands">{about.brands.join(' · ')} · among others</p>
      </section>
      <section class="a-row ruled" aria-label="Find Angela">
        <h2>Find Angela</h2>
        <div class="a-links">
          <a href={person.linkedin} target="_blank" rel="noopener">LinkedIn</a>
          <a href={`mailto:${person.email}`}>{person.email}</a>
        </div>
      </section>
      <section class="a-row ruled" aria-label="Questions people ask">
        <h2>Questions people ask</h2>
        <dl class="a-faq">
          {faq.map((f) => (
            <div>
              <dt>{f.q}</dt>
              {f.html ? <dd set:html={f.html} /> : <dd>{f.a}</dd>}
            </div>
          ))}
        </dl>
      </section>
    </div>
    <footer class="wrap a-foot">
      <a href="/">&larr; Back to work</a>
      <span class="lab">&copy; 2026 {person.name}</span>
    </footer>
  </main>
</Base>
